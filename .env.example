# Copy to .env and fill in.
# Admin credentials (checked by app/api/admin/login/route.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Value the auth_token cookie must carry (checked by middleware.js and admin API routes).
# Generate one with: openssl rand -base64 24
ADMIN_SESSION_TOKEN=
# Vercel Blob store token. Added automatically in Vercel when you connect a Blob
# store to the project. Leave empty locally to read/write data/posts.json directly.
BLOB_READ_WRITE_TOKEN=